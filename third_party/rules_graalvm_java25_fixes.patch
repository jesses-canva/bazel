--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -58,7 +58,6 @@
 bazel_dep(
     name = "rules_cc",
     version = "0.0.9",
-    dev_dependency = True,
 )
 bazel_dep(
     name = "rules_testing",
